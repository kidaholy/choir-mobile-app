# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at build time.
#
# Both values are safe to ship inside the app bundle: the URL identifies the
# project and the anon key is a public,RLS-scoped JWT by design. NEVER put the
# `postgres` password or the service_role key in these two — those are server
# secrets and must never reach a phone.
#
# Find them in: Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://hnbobvodnmlwhmgwgdwt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
